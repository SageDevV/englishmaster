rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email == 'pandredbz@gmail.com';
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validAttemptCreate(attemptId) {
      let exam = get(/databases/$(database)/documents/exams/$(request.resource.data.examId));
      return request.resource.data.keys().hasOnly([
          'examId', 'examTitle', 'userId', 'userEmail', 'firstName', 'lastName',
          'status', 'startedAt', 'examSnapshot', 'answers', 'updatedAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userEmail == request.auth.token.email
        && request.resource.data.examTitle == exam.data.title
        && attemptId == request.resource.data.examId + '__' + request.auth.uid
        && request.resource.data.status == 'in_progress'
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() >= 2
        && request.resource.data.firstName.size() <= 80
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() >= 2
        && request.resource.data.lastName.size() <= 80
        && request.resource.data.startedAt is timestamp
        && request.resource.data.startedAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.examSnapshot is map
        && request.resource.data.examSnapshot.keys().hasOnly(['title', 'questions', 'gradingSalt'])
        && request.resource.data.examSnapshot.title == exam.data.title
        && request.resource.data.examSnapshot.questions == exam.data.questions
        && request.resource.data.examSnapshot.gradingSalt == exam.data.gradingSalt
        && request.resource.data.answers is list
        && request.resource.data.answers.size() == exam.data.questionCount
        && (!exam.data.keys().hasAny(['classId'])
          || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentProfile.keys().hasAny(['classId'])
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentProfile.classId == exam.data.classId)
          || (!(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentProfile.keys().hasAny(['classId']))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentProfile.className == exam.data.className))
        && exam.data.active == true
        && (!exam.data.keys().hasAny(['deleted']) || exam.data.deleted == false);
    }

    function validAttemptUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let exam = get(/databases/$(database)/documents/exams/$(resource.data.examId));
      let immutableFieldsMatch = request.resource.data.examId == resource.data.examId
        && request.resource.data.examTitle == resource.data.examTitle
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.userEmail == resource.data.userEmail
        && request.resource.data.firstName == resource.data.firstName
        && request.resource.data.lastName == resource.data.lastName
        && request.resource.data.startedAt == resource.data.startedAt;
      let validAnswers = request.resource.data.answers is list
        && ((resource.data.examSnapshot is map
            && request.resource.data.answers.size() == resource.data.examSnapshot.questions.size())
          || (!(resource.data.examSnapshot is map)
            && request.resource.data.answers.size() == exam.data.questionCount));
      let validSave = request.resource.data.status == 'in_progress'
        && request.time < resource.data.startedAt + duration.value(2, 'h')
        && request.resource.data.updatedAt == request.time
        && changed.hasOnly(['answers', 'updatedAt']);
      let validSubmission = request.resource.data.status == 'submitted'
        && request.resource.data.submittedAt is timestamp
        && request.resource.data.submittedAt == request.time
        && request.resource.data.updatedAt == request.time
        && changed.hasOnly(['answers', 'status', 'submittedAt', 'updatedAt'])
        && (request.time < resource.data.startedAt + duration.value(2, 'h')
          || request.resource.data.answers == resource.data.answers);
      return resource.data.status == 'in_progress'
        && immutableFieldsMatch
        && validAnswers
        && (validSave || validSubmission);
    }

    function validAdminLogDeletion() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isAdmin()
        && resource.data.status == 'submitted'
        && request.resource.data.logDeleted == true
        && request.resource.data.logDeletedAt is timestamp
        && request.resource.data.logDeletedAt == request.time
        && changed.hasOnly(['logDeleted', 'logDeletedAt']);
    }

    function validAttachmentMetadata(attachmentId) {
      let data = request.resource.data;
      let attempt = get(/databases/$(database)/documents/examAttempts/$(data.attemptId));
      return data.keys().hasOnly([
          'attemptId', 'examId', 'questionId', 'questionIndex', 'userId',
          'fileName', 'contentType', 'size', 'chunkCount', 'sha256', 'status',
          'uploadedAt', 'updatedAt'
        ])
        && data.userId == request.auth.uid
        && data.attemptId == data.examId + '__' + request.auth.uid
        && (attachmentId == data.attemptId + '__' + data.questionId + '__a'
          || attachmentId == data.attemptId + '__' + data.questionId + '__b')
        && data.questionIndex is int
        && data.questionIndex >= 0
        && data.questionIndex < attempt.data.examSnapshot.questions.size()
        && attempt.data.examSnapshot.questions[data.questionIndex].id == data.questionId
        && attempt.data.examSnapshot.questions[data.questionIndex].type == 'zip_attachment'
        && attempt.data.userId == request.auth.uid
        && attempt.data.examId == data.examId
        && attempt.data.status == 'in_progress'
        && request.time < attempt.data.startedAt + duration.value(2, 'h')
        && data.fileName is string
        && data.fileName.size() >= 5
        && data.fileName.size() <= 255
        && data.fileName.matches('.*[.][zZ][iI][pP]')
        && data.contentType == 'application/zip'
        && data.size is int
        && data.size > 0
        && data.size <= 5242880
        && data.chunkCount is int
        && data.chunkCount >= 1
        && data.chunkCount <= 8
        && data.sha256 is string
        && data.sha256.matches('[0-9a-f]{64}')
        && data.status in ['uploading', 'ready']
        && data.uploadedAt is timestamp
        && data.uploadedAt == request.time
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    function validAttachmentChunk(attachmentId, chunkId) {
      let attachment = get(/databases/$(database)/documents/examAttachments/$(attachmentId));
      let attempt = get(/databases/$(database)/documents/examAttempts/$(attachment.data.attemptId));
      let validChunkId = (chunkId == '0' && request.resource.data.index == 0)
        || (chunkId == '1' && request.resource.data.index == 1)
        || (chunkId == '2' && request.resource.data.index == 2)
        || (chunkId == '3' && request.resource.data.index == 3)
        || (chunkId == '4' && request.resource.data.index == 4)
        || (chunkId == '5' && request.resource.data.index == 5)
        || (chunkId == '6' && request.resource.data.index == 6)
        || (chunkId == '7' && request.resource.data.index == 7);
      return attachment.data.userId == request.auth.uid
        && attachment.data.status == 'uploading'
        && attempt.data.userId == request.auth.uid
        && attempt.data.status == 'in_progress'
        && request.time < attempt.data.startedAt + duration.value(2, 'h')
        && request.resource.data.keys().hasOnly(['index', 'size', 'data', 'updatedAt'])
        && request.resource.data.index is int
        && request.resource.data.index >= 0
        && request.resource.data.index < attachment.data.chunkCount
        && validChunkId
        && request.resource.data.data is bytes
        && request.resource.data.size is int
        && request.resource.data.size == request.resource.data.data.size()
        && request.resource.data.size > 0
        && request.resource.data.size <= 655360
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time;
    }

    function canDeleteAttachment(data) {
      let attempt = get(/databases/$(database)/documents/examAttempts/$(data.attemptId));
      return data.userId == request.auth.uid
        && attempt.data.userId == request.auth.uid
        && attempt.data.status == 'in_progress'
        && request.time < attempt.data.startedAt + duration.value(2, 'h');
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if ownsUser(userId);
      allow delete: if false;
    }

    match /academicClasses/{classId} {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /academicSubjects/{subjectId} {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /studyReferences/{referenceId} {
      allow read: if isAdmin()
        || (signedIn()
          && resource.data.active == true
          && resource.data.deleted == false
          && ((get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentProfile.keys().hasAny(['classId'])
              && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentProfile.classId == resource.data.classId)
            || (!(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentProfile.keys().hasAny(['classId']))
              && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentProfile.className == resource.data.className)));
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /gameResults/{resultId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // O gabarito é armazenado apenas como hashes SHA-256. Leituras exigem login
    // e somente o professor identificado pode criar, publicar ou arquivar provas.
    match /exams/{examId} {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /examAttachments/{attachmentId} {
      allow get: if signedIn()
        && (isAdmin() || attachmentId.matches('.*__' + request.auth.uid + '__.*'));
      allow list: if isAdmin();
      allow create: if signedIn() && validAttachmentMetadata(attachmentId);
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && validAttachmentMetadata(attachmentId);
      allow delete: if signedIn() && canDeleteAttachment(resource.data);

      match /chunks/{chunkId} {
        allow get, list: if signedIn()
          && (isAdmin()
            || get(/databases/$(database)/documents/examAttachments/$(attachmentId)).data.userId == request.auth.uid);
        allow create, update: if signedIn() && validAttachmentChunk(attachmentId, chunkId);
        allow delete: if signedIn()
          && canDeleteAttachment(
            get(/databases/$(database)/documents/examAttachments/$(attachmentId)).data
          );
      }
    }

    match /examAttempts/{attemptId} {
      allow get: if signedIn()
        && (attemptId.matches('.*__' + request.auth.uid) || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && validAttemptCreate(attemptId);
      allow update: if signedIn()
        && ((resource.data.userId == request.auth.uid && validAttemptUpdate())
          || validAdminLogDeletion());
      allow delete: if false;
    }
  }
}
